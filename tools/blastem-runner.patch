diff --git a/megaldoom_runner.c b/megaldoom_runner.c
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/megaldoom_runner.c
@@ -0,0 +1,887 @@
+#include "megaldoom_runner.h"
+#include "genesis.h"
+#include "io.h"
+#include "ppm.h"
+#include "util.h"
+#include "vdp.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#ifndef M_PI
+#define M_PI 3.14159265358979323846
+#endif
+
+#define MEGALDOOM_RUNNER_VERSION 6
+#define MD_MASK_UP    0x001
+#define MD_MASK_DOWN  0x002
+#define MD_MASK_LEFT  0x004
+#define MD_MASK_RIGHT 0x008
+#define MD_MASK_A     0x010
+#define MD_MASK_B     0x020
+#define MD_MASK_C     0x040
+#define E2E_EVENT_STARTED    0x01
+#define E2E_EVENT_COMBAT_HIT 0x04
+#define E2E_EVENT_EXIT       0x80
+/* Both budgets are counted in GAMEPLAY TICKS, never in host frames. The
+ * runner callback fires once per VDP frame, but the game only advances a tick
+ * every ~10-20 of those while the camera is moving, so the same numbers
+ * expressed in host frames meant "give up after two ticks of no progress" and
+ * "switch recovery phase faster than the player can act on any of them". The
+ * game publishes its tick counter in byte 13 of the E2E mailbox. */
+#define WAYPOINT_NO_PROGRESS_LIMIT 30
+#define WAYPOINT_RECOVERY_PHASE_TICKS 8
+/* Escape hatch for the tick gate below: gameplay stops publishing ticks
+ * entirely once a level ends and the intermission takes over, but the EXIT
+ * waypoint still has to observe its event bit and finish the route. Any value
+ * comfortably longer than a real tick (~10-20 host frames under motion) keeps
+ * the gate's effect while making sure the follower can never wedge itself. */
+#define WAYPOINT_TICK_WATCHDOG_FRAMES 120
+
+typedef enum {
+    WAYPOINT_MOVE, WAYPOINT_USE, WAYPOINT_FIRE, WAYPOINT_HURT, WAYPOINT_EXIT
+} waypoint_action;
+typedef enum {
+    RECOVERY_NONE, RECOVERY_BRAKE, RECOVERY_ALIGN, RECOVERY_STRAFE
+} recovery_phase;
+typedef struct {
+    int16_t x, y, aim_x, aim_y;
+    uint16_t radius, timeout;
+    uint8_t action, event_mask, expected_action, expected_target;
+} waypoint;
+
+typedef struct {
+    uint32_t *masks, count, active, cycles_first, cycles_last;
+    uint32_t pc[64];
+    char *report, *capture;
+    uint32_t capture_every, capture_failed;
+    uint32_t mailbox, mailbox_bytes;
+    char mailbox_hex[1025];
+    uint32_t perf_mailbox, perf_mailbox_bytes;
+    char perf_mailbox_hex[1025];
+    uint32_t require_checkpoints, checkpoints_seen;
+    waypoint *waypoints;
+    uint32_t waypoint_count, waypoint_index, waypoint_started;
+    /* Gameplay clock, read from mailbox byte 13. `held_mask` is what the pad
+     * keeps reporting between ticks: an input must be held across every host
+     * frame of a tick for gameplay to sample it at all, so re-deciding per
+     * host frame both starves real inputs and manufactures phantom ones. */
+    uint8_t last_tick, tick_valid;
+    uint32_t tick_count, waypoint_started_tick, held_mask, last_decision_frame;
+    uint32_t waypoint_complete, waypoint_failed, waypoint_use_pulse, waypoint_use_serial;
+    uint32_t waypoint_use_pulses;
+    uint16_t waypoint_fire_hold;
+    uint32_t last_input_mask, input_frames;
+    int16_t previous_pose_x, previous_pose_y;
+    uint8_t previous_pose_valid;
+    uint16_t no_progress_ticks;
+    uint32_t last_distance2;
+    uint32_t best_distance2;
+    uint8_t progress_valid;
+    recovery_phase recovery;
+    int16_t last_vx, last_vy;
+    uint32_t last_distance;
+    /* Leg origin: where the player actually was when this waypoint became
+     * current. The pair (leg origin -> waypoint) is the line the run is
+     * supposed to stay on, which is the only way to see lateral drift; a
+     * heading-only view cannot distinguish "aimed at the target" from
+     * "aimed at the target from 143 units off the corridor". */
+    int16_t leg_origin_x, leg_origin_y;
+    uint8_t leg_origin_valid;
+    char *trace;
+    FILE *trace_file;
+    uint32_t trace_every;
+    int32_t trace_cross, trace_along;
+    uint8_t trace_valid;
+    char waypoint_failure[256];
+    uint8_t mailbox_raw[512];
+} runner_state;
+static runner_state state;
+
+static char *copy_string(const char *value) { size_t n = strlen(value) + 1; char *out = malloc(n); if (out) memcpy(out, value, n); return out; }
+static void set_string(char **out, const char *value) { free(*out); *out = copy_string(value); }
+
+void megaldoom_runner_set_trace(const char *path) { set_string(&state.trace, path); }
+void megaldoom_runner_set_trace_every(uint32_t every) { state.trace_every = every; }
+
+/* Each line is a (frame, mask) edge: the mask takes effect at `frame` and
+ * holds for every subsequent frame until the next line changes it (a route
+ * that presses a button at frame 10 and releases it at frame 50 only needs
+ * those two lines, not one per held frame). Without the forward-fill below,
+ * any frame not explicitly listed defaulted to 0 (via the memset on growth),
+ * so a held button was released again on the very next frame -- set_input()
+ * saw mask 0 versus a previous mask with the bit set and called gamepad_up
+ * immediately, one frame after the gamepad_down. */
+void megaldoom_route_load(const char *path)
+{
+    FILE *file = fopen(path, "r"); uint32_t frame, mask, capacity = 0;
+    uint32_t prev_frame = 0, prev_mask = 0; int have_prev = 0;
+    if (state.waypoints) fatal_error("--md-route and --md-waypoints cannot be combined\n");
+    if (!file) fatal_error("Could not open deterministic route %s\n", path);
+    while (fscanf(file, "%u %x", &frame, &mask) == 2) {
+        if (frame >= capacity) { uint32_t next = capacity ? capacity : 256; while (frame >= next) next *= 2; state.masks = realloc(state.masks, sizeof(*state.masks) * next); if (!state.masks) fatal_error("Out of memory loading route\n"); memset(state.masks + capacity, 0, sizeof(*state.masks) * (next - capacity)); capacity = next; }
+        if (have_prev) { for (uint32_t f = prev_frame; f < frame; f++) state.masks[f] = prev_mask; }
+        state.masks[frame] = mask; state.count = frame + 1;
+        prev_frame = frame; prev_mask = mask; have_prev = 1;
+    }
+    fclose(file);
+}
+
+/* One action per line: X Y AIM_X AIM_Y ARRIVAL_RADIUS ACTION EVENT_MASK
+ * EXPECTED_ACTION EXPECTED_TARGET TIMEOUT.  The last three expectation
+ * columns are optional for legacy waypoint files; generated USE actions must
+ * provide them.  ARRIVAL_RADIUS is intentionally distinct from the game's
+ * reach: being near a surface must not make a loose navigation pose usable.
+ * ACTION is MOVE, USE, FIRE, HURT or EXIT. EVENT_MASK is hexadecimal and is
+ * checked against byte 0 of DebugE2EState after USE/FIRE/EXIT; HURT waits for
+ * its god-hit counter (byte 7).  The format deliberately stores world-space
+ * waypoints, never a frame count, so a render-cost change cannot steer a run.
+ */
+void megaldoom_waypoints_load(const char *path)
+{
+    FILE *file = fopen(path, "r");
+    char line[256], action[16];
+    uint32_t capacity = 0, radius, event_mask, timeout;
+    int x, y, aim_x, aim_y, expected_action = -1, expected_target = -1;
+    if (state.masks) fatal_error("--md-route and --md-waypoints cannot be combined\n");
+    if (!file) fatal_error("Could not open waypoint route %s\n", path);
+    while (fgets(line, sizeof(line), file)) {
+        waypoint_action parsed;
+        char *start = line;
+        while (*start == ' ' || *start == '\t') start++;
+        if (!*start || *start == '#' || *start == '\n') continue;
+        int fields = sscanf(start, "%d %d %d %d %u %15s %x %d %d %u", &x, &y, &aim_x, &aim_y,
+                            &radius, action, &event_mask, &expected_action, &expected_target, &timeout);
+        if (fields == 8) {
+            /* The 8-column v1 format puts TIMEOUT where the v2 parser just
+             * stored expected_action. Parse it again rather than silently
+             * treating an uninitialized timeout as valid. */
+            if (sscanf(start, "%d %d %d %d %u %15s %x %u", &x, &y, &aim_x, &aim_y,
+                       &radius, action, &event_mask, &timeout) != 8) {
+                fields = 0;
+            }
+            expected_action = expected_target = -1;
+        }
+        if ((fields != 8 && fields != 10) ||
+            radius == 0 || timeout == 0 || x < -32768 || x > 32767 ||
+            y < -32768 || y > 32767 || aim_x < -32768 || aim_x > 32767 ||
+            aim_y < -32768 || aim_y > 32767 || event_mask > 0xFF ||
+            expected_action > 255 || expected_target > 255) {
+            fatal_error("Invalid waypoint in %s: %s", path, line);
+        }
+        if (!strcmp(action, "MOVE")) parsed = WAYPOINT_MOVE;
+        else if (!strcmp(action, "USE")) parsed = WAYPOINT_USE;
+        else if (!strcmp(action, "FIRE")) parsed = WAYPOINT_FIRE;
+        else if (!strcmp(action, "HURT")) parsed = WAYPOINT_HURT;
+        else if (!strcmp(action, "EXIT")) parsed = WAYPOINT_EXIT;
+        else fatal_error("Unknown waypoint action %s in %s\n", action, path);
+        if (state.waypoint_count == capacity) {
+            uint32_t next = capacity ? capacity * 2 : 32;
+            waypoint *grown = realloc(state.waypoints, sizeof(*grown) * next);
+            if (!grown) fatal_error("Out of memory loading waypoint route\n");
+            state.waypoints = grown; capacity = next;
+        }
+        waypoint *out = &state.waypoints[state.waypoint_count++];
+        out->x = (int16_t)x; out->y = (int16_t)y;
+        out->aim_x = (int16_t)aim_x; out->aim_y = (int16_t)aim_y;
+        out->radius = (uint16_t)radius;
+        out->action = (uint8_t)parsed; out->event_mask = (uint8_t)event_mask;
+        out->expected_action = fields == 10 ? (uint8_t)expected_action : 0xFF;
+        out->expected_target = fields == 10 ? (uint8_t)expected_target : 0xFF;
+        out->timeout = (uint16_t)timeout;
+    }
+    fclose(file);
+    if (!state.waypoint_count) fatal_error("Waypoint route %s is empty\n", path);
+}
+void megaldoom_runner_set_report(const char *path) { set_string(&state.report, path); }
+void megaldoom_runner_set_mailbox(uint32_t address, uint32_t bytes) { state.mailbox = address; state.mailbox_bytes = bytes > 512 ? 512 : bytes; }
+void megaldoom_runner_set_perf_mailbox(uint32_t address, uint32_t bytes) { state.perf_mailbox = address; state.perf_mailbox_bytes = bytes > 512 ? 512 : bytes; }
+void megaldoom_runner_set_require_checkpoints(uint32_t mask) { state.require_checkpoints = mask; }
+void megaldoom_runner_set_capture(const char *directory, uint32_t every) { set_string(&state.capture, directory); state.capture_every = every; }
+void megaldoom_runner_set_capture_every(uint32_t every) { state.capture_every = every; }
+
+static void set_input(system_header *system, uint32_t mask)
+{
+    static uint32_t previous; static const uint8_t buttons[] = {DPAD_UP, DPAD_DOWN, DPAD_LEFT, DPAD_RIGHT, BUTTON_A, BUTTON_B, BUTTON_C, BUTTON_START, BUTTON_X, BUTTON_Y, BUTTON_Z, BUTTON_MODE};
+    for (uint8_t i = 0; i < sizeof(buttons); i++) { uint32_t bit = 1u << i; if ((mask & bit) != (previous & bit)) { if (mask & bit) system->gamepad_down(system, 1, buttons[i]); else system->gamepad_up(system, 1, buttons[i]); } }
+    previous = mask;
+    state.last_input_mask = mask;
+    state.input_frames++;
+}
+
+/* Reads `bytes` from Genesis work RAM at `address` into `hex_out` (a
+ * 2*bytes+1 char buffer) as lowercase hex, and returns the first byte raw
+ * (used for checkpoint-bit accumulation) or -1 if the range is invalid/out
+ * of bounds. Shared by the generic mailbox and the perf mailbox so both
+ * follow the same bounds checking. */
+static int read_mailbox(genesis_context *gen, uint32_t address, uint32_t bytes, char *hex_out, uint8_t *raw_out)
+{
+    static const char hex[] = "0123456789abcdef";
+    uint32_t offset;
+    if (address < 0xFF0000 || address >= 0x1000000 || !bytes) return -1;
+    offset = address - 0xFF0000;
+    if (offset + bytes > RAM_WORDS * 2) return -1;
+    for (uint32_t i = 0; i < bytes; i++) {
+        uint8_t value = ((uint8_t *)gen->work_ram)[(offset + i) ^ 1];
+        if (raw_out) raw_out[i] = value;
+        hex_out[i * 2] = hex[value >> 4];
+        hex_out[i * 2 + 1] = hex[value & 15];
+        if (i == 0) hex_out[bytes * 2] = 0;
+    }
+    return ((uint8_t *)gen->work_ram)[offset ^ 1];
+}
+
+static int16_t mailbox_s16(const uint8_t *raw, uint32_t offset)
+{
+    return (int16_t)(((uint16_t)raw[offset] << 8) | raw[offset + 1]);
+}
+
+static uint16_t mailbox_u16(const uint8_t *raw, uint32_t offset)
+{
+    return (uint16_t)(((uint16_t)raw[offset] << 8) | raw[offset + 1]);
+}
+
+static void waypoint_fail(const char *reason)
+{
+    if (!state.waypoint_failed) {
+        snprintf(state.waypoint_failure, sizeof(state.waypoint_failure), "%s", reason);
+        state.waypoint_failed = 1;
+    }
+}
+
+static void waypoint_advance(void)
+{
+    state.waypoint_index++; state.waypoint_started = 0;
+    state.waypoint_use_pulse = 0; state.waypoint_use_serial = 0;
+    state.waypoint_fire_hold = 0;
+    state.no_progress_ticks = 0; state.progress_valid = 0;
+    state.best_distance2 = 0xFFFFFFFFu;
+    state.recovery = RECOVERY_NONE;
+    state.leg_origin_valid = 0;
+    if (state.waypoint_index == state.waypoint_count) state.waypoint_complete = 1;
+}
+
+static int32_t waypoint_angle_error(int32_t dx, int32_t dy, uint16_t angle)
+{
+    double desired = atan2((double)dy, (double)dx) * (256.0 / (2.0 * M_PI));
+    int32_t error = ((int32_t)desired - (int32_t)angle) & 255;
+    if (error > 127) error -= 256;
+    return error;
+}
+
+/* Decompose the pose against the leg (leg origin -> waypoint target) into a
+ * distance ALONG the leg and a signed perpendicular offset from it. `along` is
+ * clamped to the segment so a pose past the target keeps a meaningful goal.
+ * The perpendicular term is what a heading-only controller is blind to: under
+ * the game's DOOM-style thrust-plus-momentum movement
+ * (src/player_controller.c simulate_doom_movement_tic) a heading correction
+ * does not cancel lateral velocity already accumulated, so the offset
+ * integrates instead of decaying. Returns 0 when there is no usable leg. */
+static int waypoint_leg_geometry(const waypoint *current, int16_t px, int16_t py,
+                                 int32_t *along, int32_t *cross, int32_t *length)
+{
+    int32_t sx, sy, rx, ry, len2;
+    double len;
+    if (!state.leg_origin_valid) return 0;
+    sx = (int32_t)current->x - state.leg_origin_x;
+    sy = (int32_t)current->y - state.leg_origin_y;
+    len2 = sx * sx + sy * sy;
+    if (len2 <= 0) return 0;
+    len = sqrt((double)len2);
+    rx = (int32_t)px - state.leg_origin_x;
+    ry = (int32_t)py - state.leg_origin_y;
+    *along = (int32_t)(((double)(rx * sx + ry * sy)) / len);
+    *cross = (int32_t)(((double)(sx * ry - sy * rx)) / len);
+    *length = (int32_t)len;
+    if (*along < 0) *along = 0;
+    if (*along > *length) *along = *length;
+    return 1;
+}
+
+/* `travelling` selects between the two jobs this function does. Aiming at a
+ * door surface for USE is pure heading. Walking a leg is not: the player must
+ * also stay ON the leg, and heading alone cannot express that. Under
+ * thrust-plus-momentum a heading that merely points at the target is satisfied
+ * from anywhere on a widening cone, so lateral offset accumulates instead of
+ * decaying -- measured on E1M2, the run left a corridor at y=-608 by 15 units
+ * and wedged on the doorway edge while the follower reported itself aimed.
+ * The cross-track term makes being off the line an error in its own right. */
+/* Steer at a point a fixed distance ahead ALONG the certified polyline rather
+ * than at the next waypoint.
+ *
+ * The route generator emits certified cells on a 16-unit grid, so a corridor
+ * that runs at 45 degrees comes out as a zigzag of east and south steps. The
+ * immediate waypoint therefore points due east while the corridor itself runs
+ * south-east, and following it walks the player's 16-unit collision circle
+ * into the diagonal wall -- measured in E1M2's passage below (-1408,-2080),
+ * where the free channel is a single diagonal band and the run wedged at
+ * (-1427,-2076) with the target due east of it. Averaging the next few cells
+ * into one goal point recovers the direction the corridor actually has, and
+ * because the goal always sits on the certified path, lateral drift corrects
+ * itself without a separate cross-track term. */
+static void waypoint_pursuit_goal(int16_t px, int16_t py,
+                                  int32_t *goal_x, int32_t *goal_y)
+{
+    const double lookahead = 64.0;
+    double remaining = lookahead, cx = px, cy = py;
+    uint32_t i = state.waypoint_index;
+    for (;;) {
+        const waypoint *w = &state.waypoints[i];
+        double dx = (double)w->x - cx, dy = (double)w->y - cy;
+        double len = sqrt(dx * dx + dy * dy);
+        if (len > 0.0 && len >= remaining) {
+            *goal_x = (int32_t)(cx + dx * (remaining / len));
+            *goal_y = (int32_t)(cy + dy * (remaining / len));
+            return;
+        }
+        remaining -= len;
+        cx = (double)w->x; cy = (double)w->y;
+        /* Never look past the end of the path or into a USE/FIRE pose: those
+         * are aiming positions, not corridor geometry. */
+        if (i + 1 >= state.waypoint_count) break;
+        if (state.waypoints[i + 1].action != WAYPOINT_MOVE) break;
+        i++;
+    }
+    *goal_x = (int32_t)cx; *goal_y = (int32_t)cy;
+}
+
+static uint32_t waypoint_turn(const waypoint *current, int16_t px, int16_t py,
+                              uint16_t angle, uint8_t travelling)
+{
+    int32_t aim_dx = (int32_t)current->aim_x - px;
+    int32_t aim_dy = (int32_t)current->aim_y - py;
+    int32_t error = waypoint_angle_error(aim_dx, aim_dy, angle);
+
+    /* The game turn controller is accelerated and advances several angle
+     * units per gameplay tick.  Requiring an exact zero makes it hunt around
+     * the heading (and never release the D-pad), especially on a slow render
+     * frame.  A small angular dead-band is still tight enough for USE's
+     * certified probe while allowing forward movement to take over. */
+    {
+        /* The dead-band has to shrink as the target gets close: 8 units of a
+         * 256-step circle is 11 degrees, which is a harmless heading error at
+         * 600 units out and a miss at 40. */
+        /* A tighter band for USE looked appealing -- bsp_use_in_front picks
+         * the surface nearest the aim ray, and E1M3 once pressed door group
+         * 15 where the route named 11 -- but the turn controller accelerates
+         * up to 4 angle units per frame (TURN_MAX_FP) and only decelerates
+         * on release, so a 2-unit window is narrower than a single overshoot:
+         * every correction blows past it and the heading oscillates forever,
+         * never firing C. E1M1 hung at its very first USE this way. Keep the
+         * same 8-unit band travel already uses, and get the accuracy this
+         * needs from the route generator picking a use pose whose ray
+         * resolves to the intended surface across that whole band instead
+         * (see USE_AIM_SPREAD in generate-e2e-routes.py). */
+        const int32_t remaining = (int32_t)state.last_distance;
+        const int32_t tolerance = (travelling && remaining < 96) ? 3 : 8;
+        if (error >= -tolerance && error <= tolerance) return 0;
+    }
+    if (error > 0) return MD_MASK_RIGHT;
+    if (error < 0) return MD_MASK_LEFT;
+    return 0;
+}
+
+/* Throttle for a MOVE leg.  Braking has to be expressed against the waypoint's
+ * OWN arrival radius and the momentum actually on the player, never against
+ * fixed distances: with the old constants (reverse inside 192, coast inside
+ * 384, Manhattan) and the generator's 80-unit arrival radius, every approach
+ * longer than one grid step entered a band where the follower refused to
+ * accelerate but had not arrived either.  It then alternated DOWN and A|UP
+ * forever -- measured on E1M2's leg to (-240,-608): 5974 ticks of no progress
+ * oscillating between x=-98 and x=-154, never closing the last 86 units.
+ * Distances here are Euclidean, matching the arrival test in waypoint_decide;
+ * mixing Manhattan into a Euclidean comparison is how the dead band opened. */
+/* Does the path turn sharply at the waypoint being approached? Certified
+ * routes through DOOM's diagonal passages are one-cell-wide staircases -- the
+ * free space around E1M2's (-1392,-2080) is a single 16-unit channel with wall
+ * on both diagonals -- so carrying speed into a corner puts the player's
+ * 16-unit collision circle into the wall the staircase existed to avoid. */
+static uint8_t waypoint_corner_ahead(const waypoint *current)
+{
+    const waypoint *next;
+    double ax, ay, bx, by, la, lb;
+    if (state.waypoint_index + 1 >= state.waypoint_count) return 0;
+    if (!state.leg_origin_valid) return 0;
+    next = &state.waypoints[state.waypoint_index + 1];
+    ax = (double)current->x - state.leg_origin_x;
+    ay = (double)current->y - state.leg_origin_y;
+    bx = (double)next->x - current->x;
+    by = (double)next->y - current->y;
+    la = sqrt(ax * ax + ay * ay);
+    lb = sqrt(bx * bx + by * by);
+    if (la <= 0.0 || lb <= 0.0) return 0;
+    /* cos 40 degrees; anything tighter is a corner to be taken slowly. */
+    return ((ax * bx + ay * by) / (la * lb)) < 0.766 ? 1 : 0;
+}
+
+static uint32_t waypoint_move_drive(int32_t distance, int32_t radius,
+                                    int32_t dx, int32_t dy,
+                                    int16_t vx, int16_t vy, uint8_t have_velocity,
+                                    uint8_t corner)
+{
+    const int32_t toward = (int32_t)vx * dx + (int32_t)vy * dy;
+    const int32_t speed = (vx < 0 ? -vx : vx) + (vy < 0 ? -vy : vy);
+    /* DOOM friction bleeds momentum over several ticks rather than stopping
+     * the player dead, so the gap that the current momentum will still carry
+     * is what decides whether thrust is needed. */
+    const int32_t stopping = speed * 3;
+    if (have_velocity && toward > 0 && distance <= radius) return MD_MASK_DOWN;
+    /* A corner is entered slowly by coasting sooner, never by reversing.
+     * Reversing here made the follower press DOWN whenever it was within
+     * radius + stopping of a corner, which at speed is a band far wider than
+     * the gap itself: it braked, drifted backwards along its own facing,
+     * re-accelerated, and walked itself west out of E1M2's staircase instead
+     * of through it. Friction alone bleeds the speed off without ever pushing
+     * the player the wrong way. */
+    if (have_velocity && toward > 0 &&
+        distance <= radius + (corner ? stopping * 2 : stopping)) {
+        return 0;
+    }
+    return MD_MASK_A | MD_MASK_UP;
+}
+
+static uint32_t waypoint_recovery_input(int32_t dx, int32_t dy, uint16_t angle)
+{
+    const uint16_t phase = (uint16_t)((state.no_progress_ticks /
+                                      WAYPOINT_RECOVERY_PHASE_TICKS) % 6);
+    int32_t error;
+    if (phase == 0) {
+        state.recovery = RECOVERY_BRAKE;
+        /* Reverse only while the mailbox still shows real momentum.  Sending
+         * DOWN to a stationary player turns recovery into a long walk away
+         * from the corridor (the exact drift this harness is meant to expose).
+         * A zero-speed stall is already braked; release input for this phase. */
+        if ((int32_t)state.last_vx * state.last_vx +
+            (int32_t)state.last_vy * state.last_vy > 0) {
+            return MD_MASK_DOWN;
+        }
+        return 0;
+    }
+    error = waypoint_angle_error(dx, dy, angle);
+    if (phase == 1) {
+        state.recovery = RECOVERY_ALIGN;
+        if (error > 8) return MD_MASK_RIGHT;
+        if (error < -8) return MD_MASK_LEFT;
+        return 0;
+    }
+    if (phase == 2) {
+        /* C+direction is the game's strafe chord.  player_controller.c
+         * explicitly suppresses PLAYER_CONTROL_USE for a directional C
+         * chord, so this cannot create an interaction serial. */
+        state.recovery = RECOVERY_STRAFE;
+        if (error > 0) return MD_MASK_A | MD_MASK_C | MD_MASK_RIGHT;
+        if (error < 0) return MD_MASK_A | MD_MASK_C | MD_MASK_LEFT;
+        return MD_MASK_A | MD_MASK_C | MD_MASK_RIGHT;
+    }
+    if (phase == 4) {
+        /* Nothing kinematic has worked, so consider that the obstruction is a
+         * thing rather than geometry: an unawakened monster standing in a
+         * corridor blocks the player exactly like a wall and never moves on
+         * its own. Measured on E1M2's leg to (-192,-608), the run held forward
+         * for 73,378 host frames across 6,002 ticks and the pose changed six
+         * times. Shooting is ordinary gameplay -- the route already contains
+         * FIRE waypoints -- and B must be released between shots for the
+         * semi-auto edge, so alternate on the gameplay clock. */
+        state.recovery = RECOVERY_NONE;
+        if (error > 8) return MD_MASK_RIGHT;
+        if (error < -8) return MD_MASK_LEFT;
+        if (state.no_progress_ticks & 1) return MD_MASK_A | MD_MASK_UP | MD_MASK_B;
+        return MD_MASK_A | MD_MASK_UP;
+    }
+    if (phase == 3) {
+        state.recovery = RECOVERY_NONE;
+        /* Re-enter the normal target vector after the short lateral wiggle;
+         * recovery must converge on the same waypoint, never orbit it. */
+        if (error > 8) return MD_MASK_RIGHT;
+        if (error < -8) return MD_MASK_LEFT;
+        return MD_MASK_A | MD_MASK_UP;
+    }
+    return MD_MASK_A | MD_MASK_UP;
+}
+
+static uint32_t waypoint_decide(uint32_t frame)
+{
+    waypoint *current;
+    int32_t dx, dy;
+    int16_t px, py, vx = 0, vy = 0;
+    uint8_t have_velocity = 0;
+    uint32_t distance2;
+    if (!state.waypoints || state.waypoint_complete || state.waypoint_failed) return 0;
+    if (!(state.mailbox_raw[0] & E2E_EVENT_STARTED)) return 0;
+    if (mailbox_u16(state.mailbox_raw, 18) == 0xFFFF) return 0;
+    if (mailbox_s16(state.mailbox_raw, 14) == -32768 ||
+        mailbox_s16(state.mailbox_raw, 16) == -32768) return 0;
+    current = &state.waypoints[state.waypoint_index];
+    if (!state.waypoint_started) {
+        state.waypoint_started = frame;
+        state.waypoint_started_tick = state.tick_count;
+    }
+    /* Deadline in gameplay ticks. Spending it in host frames let a heavier
+     * frame consume a waypoint's whole budget without the player having taken
+     * a single step, which is exactly the "a render-cost change must not steer
+     * a run" contract this file's waypoint format was designed around. */
+    if (state.tick_count - state.waypoint_started_tick > current->timeout) {
+        snprintf(state.waypoint_failure, sizeof(state.waypoint_failure),
+                 "timeout wp=%u action=%u pose=%d,%d angle=%u target=%d,%d aim=%d,%d velocity=%d,%d distance=%u recovery=%u noProgress=%u use=%u/%u result=%u:%u",
+                 state.waypoint_index, current->action, mailbox_s16(state.mailbox_raw, 14),
+                 mailbox_s16(state.mailbox_raw, 16), mailbox_u16(state.mailbox_raw, 18),
+                 current->x, current->y, current->aim_x, current->aim_y,
+                 state.last_vx, state.last_vy, state.last_distance,
+                 state.recovery, state.no_progress_ticks,
+                 state.waypoint_use_serial, state.mailbox_raw[9], state.mailbox_raw[10],
+                 state.mailbox_raw[11]);
+        waypoint_fail(state.waypoint_failure);
+        return 0;
+    }
+    px = mailbox_s16(state.mailbox_raw, 14);
+    py = mailbox_s16(state.mailbox_raw, 16);
+    if (state.previous_pose_valid) {
+        vx = (int16_t)(px - state.previous_pose_x);
+        vy = (int16_t)(py - state.previous_pose_y);
+        have_velocity = 1;
+    }
+    state.previous_pose_x = px;
+    state.previous_pose_y = py;
+    state.last_vx = vx; state.last_vy = vy;
+    state.previous_pose_valid = 1;
+    if (!state.leg_origin_valid) {
+        /* The leg is the CERTIFIED edge (previous waypoint -> this one), not
+         * the chord from wherever the player happens to stand. A generous
+         * arrival radius lets one pose satisfy several waypoints in a row, and
+         * anchoring the leg to that pose turns the survivors into a diagonal
+         * shortcut -- across a staircase corner, straight into the wall the
+         * staircase existed to go around. Anchoring it to the previous
+         * waypoint instead means the cross-track term pulls the player back
+         * onto the path the certifier actually proved. */
+        if (state.waypoint_index > 0) {
+            const waypoint *previous = &state.waypoints[state.waypoint_index - 1];
+            state.leg_origin_x = previous->x; state.leg_origin_y = previous->y;
+        } else {
+            state.leg_origin_x = px; state.leg_origin_y = py;
+        }
+        state.leg_origin_valid = 1;
+    }
+    dx = (int32_t)current->x - px;
+    dy = (int32_t)current->y - py;
+    {
+        int32_t along = 0, cross = 0, length = 0;
+        state.trace_valid = (uint8_t)waypoint_leg_geometry(current, px, py,
+                                                           &along, &cross, &length);
+        state.trace_along = along;
+        state.trace_cross = cross;
+    }
+    distance2 = (uint32_t)(dx * dx + dy * dy);
+    state.last_distance = (uint32_t)sqrt((double)distance2);
+    /* Progress is measured against the CLOSEST this waypoint has ever been,
+     * not against the previous frame. Comparing to the previous frame let a
+     * player bouncing off geometry reset the counter on every rebound: the
+     * distance dipped, the counter cleared, and no_progress_ticks never
+     * reached WAYPOINT_NO_PROGRESS_LIMIT, so recovery never engaged and the
+     * run simply burned its whole frame budget in place. Against the best
+     * distance, oscillation accumulates and recovery fires as designed. */
+    if (state.progress_valid && distance2 + 16 >= state.best_distance2) {
+        if (state.no_progress_ticks != 0xFFFF) state.no_progress_ticks++;
+    } else {
+        state.no_progress_ticks = 0;
+    }
+    if (!state.progress_valid || distance2 < state.best_distance2) {
+        state.best_distance2 = distance2;
+    }
+    state.last_distance2 = distance2;
+    state.progress_valid = 1;
+    if (current->action == WAYPOINT_MOVE &&
+        distance2 <= (uint32_t)current->radius * current->radius) {
+        waypoint_advance();
+        return 0;
+    }
+    if (current->action == WAYPOINT_MOVE &&
+        state.no_progress_ticks > WAYPOINT_NO_PROGRESS_LIMIT) {
+        return waypoint_recovery_input(dx, dy,
+                                       mailbox_u16(state.mailbox_raw, 18));
+    }
+    if (current->action == WAYPOINT_USE && distance2 <= (uint32_t)current->radius * current->radius) {
+        uint32_t turn = waypoint_turn(current, mailbox_s16(state.mailbox_raw, 14),
+                                      mailbox_s16(state.mailbox_raw, 16),
+                                      mailbox_u16(state.mailbox_raw, 18), 0);
+        if (turn) return turn;
+        /* C stays down until gameplay acknowledges its rising edge. It is one
+         * logical pulse, regardless of how many emulator frames rendering took. */
+        if (!state.waypoint_use_pulse) {
+            state.waypoint_use_pulse = 1; state.waypoint_use_serial = state.mailbox_raw[9];
+            state.waypoint_use_pulses++;
+        }
+        if (state.mailbox_raw[9] == state.waypoint_use_serial) return MD_MASK_C;
+        if ((current->expected_action != 0xFF && state.mailbox_raw[10] != current->expected_action) ||
+            (current->expected_target != 0xFF && state.mailbox_raw[11] != current->expected_target) ||
+            ((state.mailbox_raw[0] & current->event_mask) != current->event_mask)) {
+            snprintf(state.waypoint_failure, sizeof(state.waypoint_failure),
+                     "wrong use wp=%u pose=%d,%d,%u expected=%u:%u got=%u:%u", state.waypoint_index,
+                     px, py, mailbox_u16(state.mailbox_raw, 18),
+                     current->expected_action, current->expected_target,
+                     state.mailbox_raw[10], state.mailbox_raw[11]);
+            waypoint_fail(state.waypoint_failure); return 0;
+        }
+        waypoint_advance();
+        return 0;
+    }
+    if (current->action == WAYPOINT_FIRE && distance2 <= (uint32_t)current->radius * current->radius) {
+        /* The mailbox bit is cumulative.  A real hit may have happened while
+         * approaching this FIRE pose, so consume that confirmed event instead
+         * of rotating forever trying to reproduce an already completed shot. */
+        if ((state.mailbox_raw[0] & current->event_mask) == current->event_mask) {
+            waypoint_advance();
+            return 0;
+        }
+        /* The approach brakes on the way to this radius, but braking there
+         * only withholds thrust -- it does not undo speed already carried
+         * into the circle. Whatever arrives moving fast still has that
+         * momentum here, and holding MD_MASK_UP as part of the shot cadence
+         * below (kept for the case a target sits just past a 16-unit
+         * collision edge) adds to it. E1M2's FIRE at (-512,-672) sits nearly
+         * on its own approach leg, so the follower ran through it, corrected
+         * heading outside, and ran back in a ~100-unit loop for the rest of
+         * the run's budget without ever standing still long enough to land a
+         * hit. Bleed the momentum down first; only creep and shoot once it
+         * has. */
+        if ((int32_t)vx * vx + (int32_t)vy * vy > 16) {
+            return MD_MASK_DOWN;
+        }
+        int32_t aim_dx = (int32_t)current->aim_x - mailbox_s16(state.mailbox_raw, 14);
+        int32_t aim_dy = (int32_t)current->aim_y - mailbox_s16(state.mailbox_raw, 16);
+        double desired = atan2((double)aim_dy, (double)aim_dx) * (256.0 / (2.0 * M_PI));
+        int32_t error = ((int32_t)desired - (int32_t)mailbox_u16(state.mailbox_raw, 18)) & 255;
+        if (error > 127) error -= 256;
+        /* A point-blank shot is still a ray test in the game.  The old
+         * 32-step dead-band let a target at the edge of the cone consume all
+         * shots while the runner reported that it was aligned. */
+        if (error > 8) return MD_MASK_RIGHT;
+        if (error < -8) return MD_MASK_LEFT;
+        /* Hold each shot for a few host frames so the ISR edge latch and the
+         * slower gameplay loop cannot miss it, then release before the next
+         * semi-auto edge. */
+        /* Keep the shot cadence, but allow a tiny normal forward correction
+         * inside the certified FIRE radius.  This avoids a target being
+         * hidden exactly behind the edge of a 16-unit collision circle while
+         * preserving the no-teleport and no-C-with-direction contracts. */
+        /* That nudge is only tiny if something caps it. A single tick of
+         * MD_MASK_UP from a dead stop is not tiny at all -- it is DOOM's full
+         * per-tick acceleration, and friction alone then takes many ticks to
+         * bleed it back off, carrying the player across that whole span
+         * before it matters again. Holding UP every tick the aim stays
+         * aligned compounds this with nothing to spend it against once the
+         * entry brake above has already zeroed velocity, and for a FIRE
+         * waypoint whose firing line runs along the approach corridor --
+         * E1M2's at (-512,-672) -- "aligned" is also "pointed down the
+         * hallway", so the player ran through the target, out the far side,
+         * all the way around and back for the rest of the run's frame budget
+         * without ever holding still long enough to land a hit. Brake
+         * actively against any velocity the single nudge (or the entry
+         * brake's own overshoot) leaves behind instead of waiting on
+         * friction; only add the forward nudge from a genuine dead stop. The
+         * shot itself (B) still fires on cadence regardless. */
+        {
+            const int32_t speed2 = (int32_t)vx * vx + (int32_t)vy * vy;
+            const uint32_t shoot = ((frame & 15) < 4) ? MD_MASK_B : 0;
+            if (speed2 > 0) return shoot | MD_MASK_DOWN;
+            return shoot | MD_MASK_UP;
+        }
+    }
+    if (current->action == WAYPOINT_HURT) {
+        if (state.mailbox_raw[7]) {
+            waypoint_advance();
+        }
+        return 0;
+    }
+    if (current->action == WAYPOINT_EXIT) {
+        if ((state.mailbox_raw[0] & current->event_mask) == current->event_mask) {
+            waypoint_advance();
+        }
+        return 0;
+    }
+    /* Steer only while travelling to MOVE/USE/FIRE locations. Angle 0 points
+     * +X in the engine; atan2 therefore maps directly to its 256-step turn. */
+    if (distance2) {
+        waypoint travel = *current;
+        /* Approach the waypoint position first; aim_x/aim_y are the surface
+         * target and may be beyond a doorway, so steering at them would cut
+         * the certified path and never enter the USE arrival radius. */
+        int32_t goal_x = current->x, goal_y = current->y;
+        if (current->action == WAYPOINT_MOVE) {
+            waypoint_pursuit_goal(px, py, &goal_x, &goal_y);
+        }
+        travel.aim_x = (int16_t)goal_x; travel.aim_y = (int16_t)goal_y;
+        uint32_t turn = waypoint_turn(&travel, mailbox_s16(state.mailbox_raw, 14),
+                                      mailbox_s16(state.mailbox_raw, 16),
+                                      mailbox_u16(state.mailbox_raw, 18), 1);
+        if (turn) return turn;
+        /* Braking on approach is not a MOVE-only concern: a FIRE or USE
+         * waypoint has its own arrival radius, and holding full thrust right
+         * up to that circle carries the player straight through it and back
+         * out the far side. E1M2's FIRE at (-512,-672) sits almost on top of
+         * its own approach leg, so the follower ran across it, corrected
+         * heading, ran back, and repeated -- distance oscillating between 4
+         * and 119 units for the rest of the run's frame budget without ever
+         * settling inside 48 to take the shot. Only a MOVE gets the corner
+         * lookahead, since that check walks the NEXT move waypoint and a
+         * FIRE/USE has none to walk to. */
+        if (current->action == WAYPOINT_MOVE || current->action == WAYPOINT_FIRE ||
+            current->action == WAYPOINT_USE) {
+            return waypoint_move_drive((int32_t)state.last_distance,
+                                       current->radius, dx, dy, vx, vy,
+                                       have_velocity,
+                                       current->action == WAYPOINT_MOVE &&
+                                           waypoint_corner_ahead(current));
+        }
+    return MD_MASK_A | MD_MASK_UP;
+}
+    return 0;
+}
+
+/* One CSV row per sampled frame. The report only ever published a single
+ * end-of-run snapshot, which is far too little to debug a 100,000-frame
+ * navigation run: it says where the follower ended up, never how it got
+ * there. Writing is strictly observational -- it reads the same mailbox the
+ * controller already read and never feeds anything back into set_input -- so a
+ * traced run and an untraced run must produce identical cycle counts. */
+static void trace_row(uint32_t frame, uint32_t mask)
+{
+    const waypoint *current;
+    if (!state.trace_file) return;
+    if (state.trace_every > 1 && (frame % state.trace_every)) return;
+    if (!state.waypoints || state.waypoint_index >= state.waypoint_count) return;
+    current = &state.waypoints[state.waypoint_index];
+    fprintf(state.trace_file,
+            "%u,%u,%u,%u,%d,%d,%u,%d,%d,%d,%d,%u,%d,%d,%d,%d,%u,%u,%u,%u\n",
+            frame, state.tick_count, state.waypoint_index, current->action,
+            mailbox_s16(state.mailbox_raw, 14), mailbox_s16(state.mailbox_raw, 16),
+            mailbox_u16(state.mailbox_raw, 18),
+            current->x, current->y,
+            (int32_t)current->x - mailbox_s16(state.mailbox_raw, 14),
+            (int32_t)current->y - mailbox_s16(state.mailbox_raw, 16),
+            state.last_distance, state.last_vx, state.last_vy,
+            state.trace_cross, state.trace_along, state.trace_valid,
+            state.no_progress_ticks, (uint32_t)state.recovery, mask);
+}
+
+/* Decide at most once per gameplay tick, and hold the decision in between.
+ *
+ * The runner callback runs at the VDP's rate; the game's movement, turning and
+ * USE handling all advance in waypoint_decide's terms only when the gameplay
+ * loop iterates, which during camera motion is roughly every ten to twenty
+ * host frames (see the release cadence measurements in AGENTS.md). Deciding
+ * per host frame made every timer in the follower run about ten times too
+ * fast -- a 30-frame no-progress budget expired after two ticks of real
+ * movement, and the four recovery phases cycled entirely within a single tick,
+ * so the player received an incoherent blur of brake/align/strafe instead of
+ * any one of them. Gating here fixes all of those at once and leaves the
+ * control law itself untouched. */
+static uint32_t waypoint_input(uint32_t frame)
+{
+    uint8_t tick;
+    if (!state.waypoints || state.waypoint_complete || state.waypoint_failed) return 0;
+    tick = state.mailbox_raw[13];
+    if (state.tick_valid && tick == state.last_tick &&
+        frame - state.last_decision_frame < WAYPOINT_TICK_WATCHDOG_FRAMES) {
+        return state.held_mask;
+    }
+    if (state.tick_valid && tick != state.last_tick) state.tick_count++;
+    state.last_tick = tick;
+    state.tick_valid = 1;
+    state.last_decision_frame = frame;
+    state.held_mask = waypoint_decide(frame);
+    return state.held_mask;
+}
+
+/* MEGALDOOM_MIN_CAPTURE_FRAME: the VDP hasn't finished a real frame yet on
+ * the very first megaldoom_runner_on_frame call, so a capture requested at
+ * frame 0 would read a framebuffer that's still zeroed/partial. Delay
+ * capture until at least one full frame has been observed. */
+#define MEGALDOOM_MIN_CAPTURE_FRAME 2
+
+/* Deterministic routes always run BlastEm in headless batch mode (-b), where
+ * the VDP renders into a plain malloc'd buffer (see vdp.c's init_vdp_context:
+ * "if (headless) { context->fb = malloc(...); }") and the normal SDL present
+ * path in render_sdl.c -- the only place that ever consumes a path queued via
+ * render_save_screenshot() -- never runs. Calling render_save_screenshot()
+ * here would silently queue a path that's never written; export the VDP
+ * framebuffer directly with BlastEm's own save_ppm() instead. */
+static void request_capture(genesis_context *gen, uint32_t frame)
+{
+    char path[1024];
+    int written = snprintf(path, sizeof(path), "%s/frame-%06u.ppm", state.capture, frame);
+    if (written <= 0 || (size_t)written >= sizeof(path)) {
+        state.capture_failed = 1;
+        fatal_error("Capture path too long for frame %u in %s\n", frame, state.capture);
+    }
+    FILE *file = fopen(path, "wb");
+    if (!file) {
+        state.capture_failed = 1;
+        fatal_error("Could not open capture file %s for frame %u\n", path, frame);
+    }
+    /* context->output_lines is reset to 0 the instant a frame completes (see
+     * vdp.c's frame-boundary handling, "context->output_lines = 0;"), which
+     * happens before control returns up to the genesis.c call site that
+     * invokes megaldoom_runner_on_frame -- by the time we get here it's
+     * already 0. inactive_start/border_top/border_bot are only touched on
+     * mode-register writes, not per frame, so their sum is a stable height
+     * for the currently configured video mode. */
+    uint32_t height = gen->vdp->inactive_start + gen->vdp->border_top + gen->vdp->border_bot;
+    save_ppm(file, gen->vdp->fb, LINEBUF_SIZE, height, gen->vdp->output_pitch);
+    fclose(file);
+}
+
+void megaldoom_runner_on_frame(system_header *system, uint32_t frame, uint32_t cycles)
+{
+    if (!state.active++) state.cycles_first = cycles; state.cycles_last = cycles;
+    if (system->type == SYSTEM_GENESIS) {
+        genesis_context *gen = (genesis_context *)system;
+        int checkpoint_byte;
+        state.pc[(gen->m68k->last_prefetch_address >> 1) & 63]++;
+        checkpoint_byte = read_mailbox(gen, state.mailbox, state.mailbox_bytes,
+                                       state.mailbox_hex, state.mailbox_raw);
+        /* Checkpoint bits ride on byte 0 of the generic --md-mailbox range
+         * (the game publishes them at a src/debug_checkpoint.c-owned
+         * address); OR across the whole run since bits like MENU are
+         * transient and would otherwise be lost once gameplay starts. */
+        if (checkpoint_byte >= 0) state.checkpoints_seen |= (uint32_t)checkpoint_byte;
+        read_mailbox(gen, state.perf_mailbox, state.perf_mailbox_bytes,
+                     state.perf_mailbox_hex, NULL);
+        if (state.masks) set_input(system, frame < state.count ? state.masks[frame] : 0);
+        else if (state.waypoints) {
+            uint32_t mask = waypoint_input(frame);
+            set_input(system, mask);
+            if (state.trace && !state.trace_file) {
+                state.trace_file = fopen(state.trace, "w");
+                if (state.trace_file) {
+                    fprintf(state.trace_file,
+                            "frame,tick,wp,action,px,py,angle,tx,ty,dx,dy,distance,"
+                            "vx,vy,cross,along,legValid,noProgress,recovery,mask\n");
+                }
+            }
+            trace_row(frame, mask);
+        }
+        if (state.capture && state.capture_every && frame >= MEGALDOOM_MIN_CAPTURE_FRAME && !(frame % state.capture_every)) {
+            request_capture(gen, frame);
+        }
+    }
+}
+void megaldoom_runner_finish(void)
+{
+    if (state.trace_file) { fclose(state.trace_file); state.trace_file = NULL; }
+    if (!state.report) return;
+    FILE *file = fopen(state.report, "w"); if (!file) return;
+    uint32_t checkpoints_ok = (state.checkpoints_seen & state.require_checkpoints) == state.require_checkpoints;
+    fprintf(file, "{\n  \"schemaVersion\": 2,\n  \"frames\": %u,\n  \"cycles\": %u,\n  \"pcHistogram\": [", state.active, state.cycles_last - state.cycles_first);
+    for (uint32_t i = 0; i < 64; i++) fprintf(file, "%s%u", i ? ", " : "", state.pc[i]);
+    fprintf(file, "],\n  \"captureFailed\": %s,\n  \"mailbox\": \"%s\",\n  \"perfMailbox\": \"%s\",\n  \"checkpoints\": {\"seen\": %u, \"required\": %u, \"ok\": %s},\n  \"waypoints\": {\"enabled\": %s, \"complete\": %s, \"failed\": %s, \"current\": %u, \"total\": %u, \"usePulses\": %u, \"lastInputMask\": %u, \"inputFrames\": %u, \"pose\": {\"x\": %d, \"y\": %d, \"angle\": %u, \"velocityX\": %d, \"velocityY\": %d, \"distance\": %u}, \"recovery\": %u, \"noProgress\": %u, \"reason\": \"%s\"}\n}\n",
+            state.capture_failed ? "true" : "false", state.mailbox_hex, state.perf_mailbox_hex,
+            state.checkpoints_seen, state.require_checkpoints, checkpoints_ok ? "true" : "false",
+            state.waypoints ? "true" : "false", state.waypoint_complete ? "true" : "false",
+            state.waypoint_failed ? "true" : "false", state.waypoint_index,
+            state.waypoint_count, state.waypoint_use_pulses, state.last_input_mask,
+            state.input_frames, mailbox_s16(state.mailbox_raw, 14),
+            mailbox_s16(state.mailbox_raw, 16), mailbox_u16(state.mailbox_raw, 18),
+            state.last_vx, state.last_vy, state.last_distance, state.recovery,
+            state.no_progress_ticks, state.waypoint_failure);
+    fclose(file);
+}
