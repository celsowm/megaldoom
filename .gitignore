# SGDK build outputs
out/
build/
obj/
res/*.s
res/*.h
*.bin
*.gen
*.lst
*.out
*.sym
*.map
*.o
*.elf
*.md5
*.srec
*.iso
*.cue
*.WAD

# WAD-extracted original Doom PNGs (copyrighted source material, not for commit)
res/originaldoom/
# Doom frontend PNGs generated from copyrighted WAD art and regenerated on demand.
res/frontend/
# MUS lumps extracted from WAD and intermediate MIDI conversions (regenerable
# via tools/extract-mus.py + tools/midi2vgm/mus2midi.py; derived from WAD)
res/music/mus/
res/music/*.mid
# Doom DS* sound-effect lumps extracted to WAV (regenerable via
# tools/extract-sfx.py; copyrighted material derived from WAD)
res/sound/
tools/__pycache__/
__pycache__/

# Local toolchains and emulators downloaded by scripts
.toolchain/
.tools/
.externals/

# Local environment overrides
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs / temp
*.log
*.tmp
*.bak
